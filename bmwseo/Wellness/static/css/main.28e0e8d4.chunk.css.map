/* Statistics.css */
.statistics-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
  }

  .team-members-list {
    list-style-type: none;
    padding: 0;
  }
  
  .team-members-list li {
    border-bottom: 1px solid #ccc;
    padding: 10px 0;
    display: flex;
    align-items: center;
    text-transform: capitalize;
    justify-content: space-between;
  }
  
  .team-members-list-button {
    border-radius: 0px;
    width: fit-content;
    height: fit-content;
  }

  .list-item-content {
    display: flex;
    align-items: center;
  }
  
  .list-item-content button {
    margin-left: 10px;
  }
  
  @media (max-width: 600px) {
    .statistics-container {
      padding: 10px;
    }
  }

.container {
  display: flex;
  justify-content: space-around; /* Adjust as needed */
  align-items: center;
}

.your-component {
  flex: 1; /* Distribute available space equally among components */
  text-align: center;
}

.top-text,
.bottom-text {
  font-size: 16px;
  margin: 10px;
}

.middle-text-blue {
  font-size: 24px;
  margin: 20px;
  color: #124bbd; /* Blue color */
}

.middle-text-green {
  font-size: 24px;
  margin: 20px;
  color: #0e660e; /* Green color */
}

.middle-text-red {
  font-size: 24px;
  margin: 20px;
  color: #da0303; /* Red color */
}

.middle-text-purple {
  font-size: 24px;
  margin: 20px;
  color: #9248af; /* Purple color */
}

.middle-text-orange {
  font-size: 24px;
  margin: 20px;
  color: #ce7426; /* Orange color */
}

.table-container {
  margin: 20px;
}

.styled-table {
  width: 100%;
  border-collapse: collapse;
  border-spacing: 0;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  overflow: hidden;
  border-radius: 10px;
}

.styled-table thead th {
  background-color: #009688;
  color: #ffffff;
  font-weight: bold;
  text-align: left;
  padding: 12px;
}

.styled-table tbody td {
  border-bottom: 1px solid #e0e0e0;
  padding: 12px;
}

.styled-table tbody tr:last-child td {
  border-bottom: none;
}

.styled-table tbody tr:hover {
  background-color: #f5f5f5;
}

.styled-table th {
  cursor: pointer;
}


.icon {
  width: 20px; /* Set the width of the icon */
  height: 20px; /* Set the height of the icon */
  cursor: pointer; /* Add pointer cursor to indicate it's clickable */
}

/* Optionally, you can add some styling for the hover effect */
.icon:hover {
  opacity: 0.8; /* Reduce opacity on hover */
}

