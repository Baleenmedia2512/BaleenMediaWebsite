  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
  html, body, #root {
      font: 0.9rem sans-serif;
      background: #fff;
      color: rgb(3, 3, 3);
      height: 100vh;
      padding: 0;
      width: 100vw;
      margin: 0;
  }

  /* Style the input element */
  input {
      padding: 10px;
      border-radius: 10px;
      font-size: 16px;
      font-family: 'Poppins', sans-serif;
      border: 2px solid #2ea93f;
      width: 220px;
  }

  textarea {
    padding: 10px;
    border-radius: 10px;
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    border: 2px solid #2ea93f;
    width: 220px;
  }
  .Signup-Input {
    padding: 10px;
    margin-top: 10px;
  }
  /* Style the placeholder text */
  ::placeholder {
    color: #aaa;
  }
  
  /* Style the input when it has focus */
  input:focus {
    outline: none;
    border-color: #7fad39;
    box-shadow: 0 0 5px #7fad39;
  }
  
  /* Style the input when it's disabled */
  input:disabled {
    opacity: 0.5;
  }
  
  /* Style the input when it has an error */
  input.error {
    border-color: #d93025;
    box-shadow: 0 0 5px #d93025;
  }
  
  /* Style the input when it's valid */
  input.valid {
    border-color: #1db954;
    box-shadow: 0 0 5px #1db954;
  }

  input[name="Physical-Activity-InputBox"] {
    width: 150px;
    padding: 10px;
  }

  .Update-InputBox {
    margin: 10px;
    align-self: center;
    text-align: center;
    justify-self: center;
    width: 300px;
    font-size: 12px;
    resize: none;
  }

  /* Style the label element */
  label {
    font-size: 18px;
    font-weight: bold;
  }
  
  /* Style the container element */
  .container {
    width: 80%;
    margin: auto;
  }
  
  .main {
    text-align: center;
    justify-content: center;
    display: flex; 
    padding-top: 50px;
    padding-bottom: 90px;
    background-color: #e1e3eb;
  }

  /* Style the select element */
  .select-days {
    font-family: 'Poppins', sans-serif;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 13px;
