  }

  .userIcon{
    height: 25px;
    width: 25px;
    position: absolute;
    padding: 14px 0 0 25px;
  }

  .sub-main {
    display: flex;
    justify-content: center;
    height: auto;
    width: 350px;
    box-shadow: 11px 12px 13px 12px rgb(207, 207, 207);
    padding-top: 30px;
