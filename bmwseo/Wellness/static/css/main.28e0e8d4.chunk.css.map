    padding-left: 10px;
    color: white;
    border: none;
    width: 150px;
    margin-top: 0px;
    text-align: center;
    background: linear-gradient(to right, rgb(133, 189, 235), rgb(77, 164, 235));
  }

  /* Style the select members */
  .select-member {
    font-family: 'Poppins', sans-serif;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 14px;
    height: 25px;
    border-radius: 10px;
    padding-left: 10px;
    color: black;
    border: none;
    width: 150px;
    margin-top: 0px;
    text-align: center;
    background: transparent;

